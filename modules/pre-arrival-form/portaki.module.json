{
  "$schema": "https://raw.githubusercontent.com/PortakiApp/portaki-sdk/main/schema/module.v1.json",
  "id": "pre-arrival-form",
  "name": {
    "fr": "Formulaire de pré-arrivée",
    "en": "Pre-arrival form"
  },
  "description": {
    "fr": "Recueille horaire, occasion, allergies avant l'arrivée.",
    "en": "Collects ETA, occasion, and allergies before arrival."
  },
  "version": "0.6.0",
  "author": {
    "name": "Portaki",
    "url": "https://portaki.app",
    "type": "official"
  },
  "icon": "clipboard",
  "type": "official",
  "emails": [
    {
      "id": "form-available",
      "audience": "guest",
      "description": {
        "fr": "Formulaire de pré-arrivée disponible",
        "en": "Pre-arrival form available"
      },
      "command": "sendFormAvailable",
      "catchUpOnPropertyPublish": true,
      "dispatchOnStayCreated": true,
      "trigger": {
        "type": "moduleCommand"
      },
      "requiresGuestEmail": true,
      "skipWhen": ["guest.email.missing", "stay.cancelled"]
    }
  ],
  "hostSurfaces": [
    {
      "type": "property-workspace-tab",
      "pathSegment": "pre-arrival-form",
      "label": {
        "fr": "Formulaire de pré-arrivée",
        "en": "Pre-arrival form"
      },
      "icon": "clipboard",
      "hostUi": {
        "designId": "prearrival-editor-v1"
      }
    },
    {
      "type": "stay-detail",
      "pathSegment": "stay",
      "label": {
        "fr": "Formulaire de pré-arrivée",
        "en": "Pre-arrival form"
      },
      "icon": "clipboard"
    }
  ],
  "guestSurfaces": [
    {
      "surfaceId": "home.card",
      "path": "pre-arrival-form",
      "labelKey": "nav.pre-arrival-form",
      "role": "arrival-formality",
      "embedsHostFragments": [
        "regulatory.police-form"
      ]
    },
    {
      "surfaceId": "guest.form",
      "path": "pre-arrival-form/form",
      "labelKey": "nav.pre-arrival-form"
    }
  ]
}

{
  "$schema": "https://raw.githubusercontent.com/PortakiApp/portaki-sdk/main/schema/module.v1.json",
  "id": "lost-found",
  "name": {
    "fr": "Objets perdus ou trouvés",
    "en": "Lost & found"
  },
  "description": {
    "fr": "Déclarez un objet trouvé depuis un séjour, le voyageur est prévenu. Le suivi est dans Statistiques.",
    "en": "Declare a found item from a stay and the guest is notified. Follow-up is in Statistics."
  },
  "version": "0.9.0",
  "requiresModuleSdk": "6.12.0",
  "author": {
    "name": "Portaki",
    "url": "https://portaki.app",
    "type": "official"
  },
  "icon": "search",
  "type": "official",
  "maturity": "stable",
  "permissions": [
    "email",
    "events",
    "platform",
    "repo"
  ],
  "sortOrder": 80,
  "hostSurfaces": [
    {
      "type": "stay-action",
      "pathSegment": "create",
      "label": {
        "fr": "Déclarer un objet trouvé",
        "en": "Declare a found item"
      },
      "icon": "search"
    },
    {
      "type": "stay-detail",
      "pathSegment": "stay",
      "label": {
        "fr": "Objets déclarés",
        "en": "Declared items"
      },
      "icon": "search"
    },
    {
      "type": "property-stats-card",
      "pathSegment": "lost-stats",
      "label": {
        "fr": "Objets trouvés",
        "en": "Lost & found"
      },
      "icon": "search"
    },
    {
      "type": "property-stats-detail",
      "pathSegment": "lost-stats",
      "label": {
        "fr": "Objets trouvés",
        "en": "Lost & found"
      },
      "icon": "search"
    }
  ],
  "guestSurfaces": [
    {
      "surfaceId": "home.card",
      "path": "lost-found",
      "labelKey": "nav.lost-found"
    },
    {
      "surfaceId": "guest.form",
      "path": "lost-found/form",
      "labelKey": "nav.lost-found"
    },
    {
      "surfaceId": "post-stay.card",
      "path": "post-stay",
      "role": "post-stay",
      "labelKey": "nav.lost-found"
    }
  ],
  "emails": [
    {
      "id": "checkout-j2",
      "audience": "guest",
      "description": {
        "fr": "Relance objets perdus J+2 après départ",
        "en": "Lost & found follow-up J+2 after checkout"
      },
      "command": "sendCheckoutFollowUp",
      "catchUpOnPropertyPublish": false,
      "dispatchOnStayCreated": false,
      "trigger": {
        "type": "relativeToCheckOut",
        "offset": "P2D"
      },
      "requiresGuestEmail": true,
      "skipWhen": [
        "guest.email.missing",
        "stay.cancelled"
      ]
    }
  ]
}

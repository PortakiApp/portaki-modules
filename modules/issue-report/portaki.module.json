{
  "$schema": "https://raw.githubusercontent.com/PortakiApp/portaki-sdk/main/schema/module.v1.json",
  "id": "issue-report",
  "name": {
    "fr": "Signaler un problème",
    "en": "Report an issue"
  },
  "description": {
    "fr": "Les voyageurs signalent un souci depuis le livret. Rien à configurer : le suivi est dans Statistiques.",
    "en": "Guests report a problem from the booklet. Nothing to configure: follow-up is in Statistics."
  },
  "version": "0.6.0",
  "requiresModuleSdk": "6.12.0",
  "author": {
    "name": "Portaki",
    "url": "https://portaki.app",
    "type": "official"
  },
  "icon": "danger-triangle",
  "type": "official",
  "maturity": "stable",
  "permissions": [
    "email",
    "events",
    "guest:files",
    "platform",
    "repo"
  ],
  "sortOrder": 90,
  "hostSurfaces": [
    {
      "type": "property-stats-card",
      "pathSegment": "issue-stats",
      "label": {
        "fr": "Signalements",
        "en": "Issue reports"
      },
      "icon": "danger-triangle"
    },
    {
      "type": "property-stats-detail",
      "pathSegment": "issue-stats",
      "label": {
        "fr": "Signalements",
        "en": "Issue reports"
      },
      "icon": "danger-triangle"
    }
  ],
  "guestSurfaces": [
    {
      "surfaceId": "home.card",
      "path": "issue-report",
      "labelKey": "nav.issue-report"
    },
    {
      "surfaceId": "guest.form",
      "path": "issue-report/form",
      "labelKey": "nav.issue-report"
    }
  ]
}

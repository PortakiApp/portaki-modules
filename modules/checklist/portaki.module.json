{
  "$schema": "https://raw.githubusercontent.com/PortakiApp/portaki-sdk/main/schema/module.v1.json",
  "id": "checklist",
  "name": {
    "fr": "Checklists",
    "en": "Checklists"
  },
  "description": {
    "fr": "Plusieurs listes à cocher : départ du voyageur, ménage, état des lieux d'arrivée et de départ.",
    "en": "Several lists to tick: guest departure, cleaning, check-in and check-out inspections."
  },
  "version": "0.6.1",
  "requiresModuleSdk": "6.14.0",
  "author": {
    "name": "Portaki",
    "url": "https://portaki.app",
    "type": "official"
  },
  "icon": "check-circle",
  "type": "official",
  "maturity": "stable",
  "permissions": [
    "events",
    "kv",
    "platform",
    "repo"
  ],
  "sortOrder": 60,
  "hostSurfaces": [
    {
      "type": "property-workspace-tab",
      "pathSegment": "checklist",
      "label": {
        "fr": "Checklists",
        "en": "Checklists"
      },
      "icon": "check-circle",
      "hostUi": {
        "designId": "checklist-editor-v1"
      }
    },
    {
      "type": "property-stats-card",
      "pathSegment": "checklist",
      "label": {
        "fr": "Checklist",
        "en": "Checklist"
      },
      "icon": "check-circle"
    },
    {
      "type": "property-stats-detail",
      "pathSegment": "checklist",
      "label": {
        "fr": "Checklist",
        "en": "Checklist"
      },
      "icon": "check-circle"
    },
    {
      "type": "property-stats-card",
      "pathSegment": "cleaning",
      "label": {
        "fr": "Ménage",
        "en": "Cleaning"
      },
      "icon": "sparkles"
    },
    {
      "type": "property-stats-detail",
      "pathSegment": "cleaning",
      "label": {
        "fr": "Ménage",
        "en": "Cleaning"
      },
      "icon": "sparkles"
    },
    {
      "type": "workspace-timeline-task",
      "pathSegment": "tasks",
      "label": {
        "fr": "Tâches",
        "en": "Tasks"
      },
      "icon": "sparkles"
    }
  ],
  "guestSurfaces": [
    {
      "surfaceId": "home.card",
      "path": "checklist",
      "labelKey": "home.card.title"
    },
    {
      "surfaceId": "post-stay.card",
      "path": "post-stay",
      "role": "post-stay",
      "labelKey": "home.card.title"
    }
  ]
}
